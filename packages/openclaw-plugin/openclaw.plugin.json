{
  "id": "osm-semantic-memory",
  "name": "OSM Semantic Memory",
  "description": "Minimal Phase-3 hook bridge for retrieval and summarize enqueue.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "agentId": { "type": "string" },
      "markerDir": { "type": "string" },
      "injectStubContext": { "type": "boolean" },
      "injectLiveContext": { "type": "boolean" },
      "osmRoot": { "type": "string" },
      "dbPath": { "type": "string" },
      "embedProviderId": { "type": "string", "enum": ["openai", "local-onnx", "local-stub"] },
      "embedModelId": { "type": "string" },
      "embedDim": { "type": "number" },
      "retrieveTopK": { "type": "number" },
      "retrieveTopN": { "type": "number" },
      "retrieveMinScore": { "type": "number" },
      "skipWeakQuery": { "type": "boolean" },
      "summarizeEnqueue": { "type": "boolean" },
      "summarizeIdleMs": { "type": "number" },
      "summarizeSettleMs": { "type": "number" },
      "summarizeTtlDays": { "type": "number" },
      "summarizeModel": { "type": "string" }
    }
  },
  "uiHints": {
