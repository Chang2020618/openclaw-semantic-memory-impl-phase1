    "embedProviderId": {
      "label": "Embedding Provider Id"
    },
    "embedModelId": {
      "label": "Embedding Model Id"
    },
    "embedDim": {
      "label": "Embedding Dimension"
    },
    "retrieveTopK": {
      "label": "Retrieve Top K"
    },
    "retrieveTopN": {
      "label": "Retrieve Top N"
    },
    "retrieveMinScore": {
      "label": "Retrieve Min Score"
    },
